+            ? `<img class="main-item-cover-img album-cover-img" src="${item.cover}" alt="">`
+            : `<svg class="main-item-cover-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="50" height="50">
