+    else if (item.type === 'folder') onclickAttr = `openFolder('${item.id}')`;
+    else if (item.type === 'all-songs') onclickAttr = `switchView('all-songs')`;
+    else if (item.type === 'favorites') onclickAttr = `switchView('favorites')`;
