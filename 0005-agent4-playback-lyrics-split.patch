-    if (!variant) return;
-
-    const sourceLines = variant.text.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
-
-    const lines = [];
-    for (const raw of sourceLines) {
-        const parsed = parseLrcLine(raw);
-        if (!parsed) continue;
-        for (const t of parsed.times) {
