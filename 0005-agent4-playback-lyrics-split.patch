-    const dur = audioElement.duration || 0;
-    let t = (audioElement.currentTime || 0) + delta;
-    if (t < 0) t = 0;
-    if (dur > 0 && t > dur) t = dur;
-    audioElement.currentTime = t;
-    updateSyncMiniPlayer();
-}
