-function updateVolume(percentage) {
-    const volume = Math.max(0, Math.min(1, percentage));
-
-    // Remember the last non-zero level so unmute can restore it.
-    if (volume > 0) {
-        window.lastMutedVolume = volume;
-    }
-    window.lastVolume = volume;
