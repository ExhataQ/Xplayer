-        if (committed) return;
-        committed = true;
-        const parsed = parseManualTime(input.value);
-        if (parsed === null) {
-            renderSyncEditorLines();
-            return;
-        }
-        syncEditorState.lines[index].time = parsed;
-        renderSyncEditorLines();
-        updateSyncEditorPreview();
-        updateSyncEditorProgress();
