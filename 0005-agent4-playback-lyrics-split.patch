-
-    timeCell.innerHTML = '<input type="text" class="sync-editor-time-input" value="' + currentStr + '" />';
-    const input = timeCell.querySelector('input');
-    if (!input) return;
-    input.focus();
-    input.select();
-
-    let committed = false;
