+    preloadGaplessSong(nextSong);
+}
+
+function usePreloadedGaplessTrack(song) {
+    if (
+        !song ||
+        gaplessPreloadedSongId !== song.id ||
+        gaplessPreloadedUrl !== song.url
+    ) {
+        return false;
+    }
